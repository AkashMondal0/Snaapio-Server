{
  "name": "snaapio-api",
  "version": "0.1.7",
  "description": "this is a snaapio api",
  "author": "akashmondal0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.18.0 <20.12.2"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/src/main.js",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "db:migrate": "npx tsx migration.ts",
    "db:generate": "npx drizzle-kit generate",
    "kafka": "docker compose -f docker-compose-kafka.yaml up -d",
    "db:migrate-normal": "npx drizzle-kit migrate",
    "db:push": "npx drizzle-kit push",
    "docker:build": "docker build -t akashmondal0/snaapio-backend:1.5 .",
    "docker:push": "docker push akashmondal0/snaapio-backend:1.5",
    "docker:run": "docker run -p 5000:5000 akashmondal0/snaapio-backend:1.5",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:load-gql": "k6 run ./k6-scripts/k6-graphql.ts",
    "test:load-rest": "k6 run /k6-scripts/k6-rest.ts",
    "deployment:start": "kubectl apply -f ./deployment/app-configmap.yaml && kubectl apply -f ./deployment/app-deployment.yaml",
    "deployment:restart": "kubectl rollout restart deployment/app-deployment",
    "deployment:scale": "kubectl apply -f ./deployment/app-hpa.yaml",
    "deployment:stop": "cd deployment && kubectl delete service app-service && kubectl delete deployment app-deployment",
    "deployment:delete-all": "kubectl delete all --all"
  },
  "dependencies": {
    "@apollo/server": "^4.10.4",
    "@as-integrations/fastify": "^2.1.1",
    "@fastify/cookie": "^9.3.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^6.0.1",
    "@fastify/static": "^6.12.0",
    "@google/generative-ai": "^0.24.0",
    "@nest-lab/fastify-multer": "^1.3.0",
    "@nestjs/apollo": "^12.1.0",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.2",
    "@nestjs/core": "^10.4.4",
    "@nestjs/graphql": "^12.1.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-fastify": "^10.4.17",
    "@nestjs/platform-socket.io": "^10.3.10",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.1.1",
    "@nestjs/websockets": "^10.3.10",
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/supabase-js": "^2.49.1",
    "@willsoto/nestjs-prometheus": "^6.0.2",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.53.0",
    "drizzle-orm": "^0.31.4",
    "expo-server-sdk": "^3.15.0",
    "fastify": "^4.29.1",
    "graphql": "^16.8.1",
    "graphql-type-json": "^0.3.2",
    "ioredis": "^5.6.1",
    "k6": "^0.0.0",
    "kafkajs": "^2.2.4",
    "mime-types": "^3.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "postgres": "^3.4.4",
    "prom-client": "^15.1.3",
    "redis": "^5.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1",
    "stripe": "^18.0.0",
    "winston": "^3.17.0",
    "winston-loki": "^6.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.4",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.5.2",
    "@types/k6": "^1.0.2",
    "@types/node": "^20.3.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.0",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "drizzle-kit": "^0.22.7",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
